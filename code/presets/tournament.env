# Settings for the tournament dataset (K3 counting, 5760x4092 LZW TIFF, 40 fractions, gain TIFF).
# Pixel size, dose and defocus were read from the EPU XML of 101 movies spread over the session:
# one pixel size throughout, dose 28.4-36.5 e/A^2 (median 33.6), defocus 0.8-2.0 um (median 1.4),
# exposure 1.61 s. The sheet disagrees on pixel size and dose; see README. Cs is not in the XML.
export MOVIE_EXT=tiff
export ANGPIX=0.8837      # XML: 1.7675 A at 2x2 binning, saved grid is 2x finer. Sheet says 0.84: ask the organizers.
export DOSE=0.84          # e/A^2/frame: median 33.6 / 40 fractions. Sheet: 42.4 total (1.06 per frame).
export KV=300             # XML AccelerationVoltage, matches the sheet
export CS=2.7             # not in the xml; assumed for a Krios
export MIN_BYTES=10000000 # LZW TIFFs are smaller than the rehearsal MRCs
export DL_LOG=/nonexistent
export GAIN=              # gain TIFF converted to MRC (see pilot4.sh g2m.py); RELION cannot read TIFF gains
export GAIN_ROT=0
export GAIN_FLIP=0
export TEMPLATES=         # none yet: bootstrap templates with LoG picks and 2D first
export PDIAM=${PDIAM:-}           # particle diameter in A (needed for LoG picking without templates); the mask DIAM is separate
export MC=mc3             # GPU motion correction (MotionCor3); unset for RELION's CPU version
export SYM=${SYM:-C1}            # rehearsal default was C3; set from the biology, a wrong symmetry hurts
